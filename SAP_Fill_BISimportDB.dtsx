  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\Clear BISimportDB"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Task &quot;SQL ausführen&quot;"
      DTS:DTSID="{68eb7297-8b93-4640-80e6-e83f15e902ea}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Clear BISimportDB"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{B0C3630F-6C3A-4EF5-B65F-E55891C1073B}"
          SQLTask:SqlStatementSource="declare @sql varchar(max) = ''&#xA;&#xA;select @sql  = @sql + 'truncate table BISimportDB.dbo.' + inp.name +';'&#xA;from sys.objects o&#xA;join BISimportDB.sys.objects inp on o.name = inp.name&#xA;where o.name like 'SAP%'&#xA;&#xA;--print @sql&#xA;exec (@sql)" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Clear SSIS log"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Task &quot;SQL ausführen&quot;"
      DTS:DTSID="{adf9e8fb-86a3-48b2-9a39-05a6bc1dd2e6}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Clear SSIS log"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2016; © 2015 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:LoggingOptions
        DTS:FilterKind="0" />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{F7560E27-2584-440B-B85C-EEEFC99D892B}"
          SQLTask:SqlStatementSource="delete from dbo.sysssislog&#xA;where executionid in &#xA;( &#xA; select distinct executionid &#xA; from dbo.sysssislog&#xA; where event = 'PackageStart' &#xA; and Source = ? &#xA; and starttime &lt; dateadd(day, -?, getdate()) &#xA;) &#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="1"
            SQLTask:DtsVariableName="User::cfgLogDays"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="20"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="System::PackageName"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="129"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Transfer data (from views) to BISimportDB"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Task &quot;SQL ausführen&quot;"
      DTS:DTSID="{EB7E1140-CF29-4DC0-9DB0-27D528322CAF}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Transfer data (from views) to BISimportDB"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{B0C3630F-6C3A-4EF5-B65F-E55891C1073B}"
          SQLTask:SqlStatementSource="DECLARE @sql VARCHAR(MAX) = '', &#xA;        @tableList VARCHAR(MAX) = '', &#xA;        @table VARCHAR(128), &#xA;        @i INT;&#xA;&#xA;-- Tabellenliste alphabetisch aufbauen&#xA;SELECT @tableList = STRING_AGG(expTab.name, ';') WITHIN GROUP (ORDER BY expTab.name) &#xA;FROM sys.objects expTab&#xA;JOIN BISimportDB.sys.objects impTab &#xA;    ON 'SAP_' + SUBSTRING(&#xA;            expTab.name, &#xA;            CHARINDEX('_', expTab.name, CHARINDEX('_', expTab.name, CHARINDEX('_', expTab.name) + 1) + 1) + 1, &#xA;            256&#xA;       ) = impTab.name&#xA;WHERE expTab.name LIKE 'T_Import[_]%' &#xA;  AND expTab.type_desc = 'USER_TABLE'&#xA;  AND impTab.type_desc = 'USER_TABLE'&#xA;  AND (LEN(expTab.name) - LEN(REPLACE(expTab.name, '_', ''))) &gt;= 3 ; -- Mindestens 3 Unterstriche&#xA;  &#xA;&#xA;-- Schleife über Tabellenliste&#xA;WHILE @tableList &lt;&gt; ''&#xA;BEGIN&#xA;    SET @i = CHARINDEX(';', @tableList)&#xA;&#xA;    IF @i &gt; 0&#xA;        SET @table = LEFT(@tableList, @i - 1)&#xA;    ELSE&#xA;        SET @table = @tableList  -- Letzter Eintrag&#xA;&#xA;    PRINT '&gt;&gt; Verarbeite Tabelle: ' + @table&#xA;&#xA;    -- Zieltabellenname aus Quellname ab drittem Unterstrich ableiten&#xA;    DECLARE @pos1 INT = CHARINDEX('_', @table)&#xA;    DECLARE @pos2 INT = CHARINDEX('_', @table, @pos1 + 1)&#xA;    DECLARE @pos3 INT = CHARINDEX('_', @table, @pos2 + 1)&#xA;    DECLARE @zielName VARCHAR(128)&#xA;&#xA;    IF @pos3 &gt; 0&#xA;    BEGIN&#xA;        SET @zielName = 'SAP_' + SUBSTRING(@table, @pos3 + 1, 256)&#xA;        PRINT '&gt;&gt; Ziel: ' + @zielName&#xA;&#xA;        -- Dynamisches SQL zusammenbauen&#xA;        SELECT @sql = &#xA;            'INSERT INTO BISimportDB.dbo.' + QUOTENAME(@zielName) + &#xA;            ' (' + x.cols + 'xHubID, xPrefix, xTypeOfDataDelivery) ' +&#xA;            'SELECT ' + x.cols + '''SICORE'', ''SICOREsap'', ''SAP'' FROM ' + QUOTENAME(@table) + ';'&#xA;        FROM &#xA;        (&#xA;            SELECT x.cols&#xA;            FROM sys.objects expTabs&#xA;            JOIN BISimportDB.sys.objects impTabs &#xA;                ON impTabs.name = @zielName&#xA;            CROSS APPLY&#xA;            (&#xA;                SELECT STRING_AGG(QUOTENAME(expCols.name) + ',', '') &#xA;                       WITHIN GROUP (ORDER BY expCols.column_id)&#xA;                FROM sys.columns expCols&#xA;                WHERE expCols.object_id = expTabs.object_id&#xA;                  AND expCols.name IN (&#xA;                      SELECT name FROM BISimportDB.sys.columns &#xA;                      WHERE object_id = impTabs.object_id&#xA;                  )&#xA;            ) x(cols)&#xA;            WHERE expTabs.name = @table&#xA;        ) x;&#xA;&#xA;        -- Jetzt wirklich ausführen&#xA;        PRINT '&gt;&gt; EXECUTE SQL für ' + @zielName&#xA;        EXEC (@sql)&#xA;        PRINT '------------------------------------------------------------'&#xA;    END&#xA;    ELSE&#xA;    BEGIN&#xA;        PRINT '&gt;&gt; WARNUNG: Tabelle &quot;' + @table + '&quot; hat weniger als drei Unterstriche – übersprungen.'&#xA;    END&#xA;&#xA;    -- Nächste Tabelle&#xA;    IF @i &gt; 0&#xA;        SET @tableList = SUBSTRING(@tableList, @i + 1, LEN(@tableList))&#xA;    ELSE&#xA;        BREAK  -- Letzter Eintrag verarbeitet&#xA;END&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
